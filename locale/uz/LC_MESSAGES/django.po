msgstr "Daniel Johnson"

#: .\templates\client\general\about.html:103
msgid "Founder & Master Barber"
msgstr "Tashabbuschi va bosh sartarosh"

#: .\templates\client\general\about.html:104
msgid ""
"With over 20 years of experience, Daniel brings exceptional skill and "
"creativity to every haircut."
msgstr ""
"20 yildan ortiq tajribaga ega Daniel har bir soch turmagiga ajoyib mahorat "
"va ijodkorlik olib keladi."

